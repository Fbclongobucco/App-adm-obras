# Environment configuration
# Copy to .env and fill in values. Required values must be set.

# Application profile
SPRING_PROFILES_ACTIVE=local

# Origens liberadas na autenticacao (/api/auth/**, com cookie). As demais rotas aceitam qualquer origem, sem cookie.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Authentication (JWT access token + refresh token cookie)
# Signing secret, required in prod profile: Base64, at least 32 bytes.
# Generate with: openssl rand -base64 32
APP_JWT_SECRET=
# Refresh token cookie SameSite policy: Strict (default), Lax or None.
# Use None only when frontend and API are on different sites without a proxy; requires Secure.
APP_REFRESH_COOKIE_SAME_SITE=Strict
# Secure cookie (HTTPS only). Ignored in prod profile, where it is always true.
APP_REFRESH_COOKIE_SECURE=true
# Partitioned cookie (CHIPS), optional for cross-site deployments. Browser support varies.
APP_REFRESH_COOKIE_PARTITIONED=false

# Bootstrap admin user, created on startup in local and test profiles (ignored in prod)
APP_BOOTSTRAP_ENABLED=true
APP_BOOTSTRAP_ADMIN_NAME=Administrador
APP_BOOTSTRAP_ADMIN_EMAIL=admin@admin.com
APP_BOOTSTRAP_ADMIN_PASSWORD=admin123

# Database (required when using prod profile; external Postgres)
DB_URL=jdbc:postgresql://localhost:5432/app_adm_obras
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# Docker Hub (for build/push script)
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=your-dockerhub-token-or-password
DOCKERHUB_REPOSITORY=your-dockerhub-username/app-adm-obras
DOCKERHUB_TAGS=
DOCKER_IMAGE_NAME=
BUILD_CONTEXT=.
DOCKERFILE_PATH=Dockerfile
