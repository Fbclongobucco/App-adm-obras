# Environment configuration
# Copy to .env and fill in values. Required values must be set.

# Application profile
SPRING_PROFILES_ACTIVE=local

# CORS origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Bootstrap admin user (optional; used in test/profile)
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_ADMIN_NAME=Administrador
APP_BOOTSTRAP_ADMIN_EMAIL=admin@admim.com
APP_BOOTSTRAP_ADMIN_PASSWORD=admin123

# Database (required when using prod profile; external Postgres)
DB_URL=jdbc:postgresql://localhost:5432/app_adm_obras
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# Docker Hub (for build/push script)
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=your-dockerhub-token-or-password
DOCKERHUB_REPOSITORY=your-dockerhub-username/app-adm-obras
DOCKERHUB_TAGS=
DOCKER_IMAGE_NAME=
BUILD_CONTEXT=.
DOCKERFILE_PATH=Dockerfile
