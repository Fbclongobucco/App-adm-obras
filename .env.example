# Environment configuration
# Copy to .env and fill in values. Never commit .env.
# Values below are for local development; see "Production" notes on each block and the README "Deploy" section.

# Application profile: local (H2, dev) or prod (PostgreSQL). Production: prod.
SPRING_PROFILES_ACTIVE=local

# Origins allowed on authentication routes (/api/auth/**: login, refresh, logout), with credentials.
# Comma-separated explicit list; '*' is rejected at startup. Production: the frontend URL, e.g. https://obras.example.com
# All other /api/** routes accept any origin without credentials (Bearer token in the header).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Authentication (JWT access token + refresh token cookie)
# Signing secret, required in prod: Base64, at least 32 bytes. Generate with: openssl rand -base64 32
# Production: a new secret per environment; changing it logs every user out.
APP_JWT_SECRET=
# Refresh token cookie SameSite policy: Strict (default), Lax or None.
# Use None only when frontend and API are on different sites without a proxy; requires Secure.
APP_REFRESH_COOKIE_SAME_SITE=Strict
# Secure cookie (HTTPS only). Ignored in prod, where it is always true.
APP_REFRESH_COOKIE_SECURE=true
# Partitioned cookie (CHIPS), optional for cross-site deployments. Browser support varies.
APP_REFRESH_COOKIE_PARTITIONED=false

# Bootstrap admin user, created on startup when enabled and the email does not exist yet (idempotent).
# Local: enabled with the development credentials below.
# Production: the prod profile disables it, but these variables override the profile. To create the first
# admin, set APP_BOOTSTRAP_ENABLED=true with a real email and a strong password for ONE start, log in,
# then set APP_BOOTSTRAP_ENABLED=false and remove the password. Never deploy with admin123.
APP_BOOTSTRAP_ENABLED=true
APP_BOOTSTRAP_ADMIN_NAME=Administrador
APP_BOOTSTRAP_ADMIN_EMAIL=admin@admin.com
APP_BOOTSTRAP_ADMIN_PASSWORD=admin123

# Database (required in prod; external PostgreSQL 16+). Flyway applies the migrations on startup.
DB_URL=jdbc:postgresql://localhost:5432/app_adm_obras
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# JVM options for the container (optional; Dockerfile default: -Xms256m -Xmx512m)
# JAVA_OPTS=-Xms256m -Xmx512m

# Docker Hub (only for scripts/docker-build-push.sh)
DOCKERHUB_USERNAME=your-dockerhub-username
# Access token (Account Settings > Personal access tokens, Read & Write), not the account password
DOCKERHUB_TOKEN=your-dockerhub-access-token
DOCKERHUB_REPOSITORY=your-dockerhub-username/app-adm-obras
# Optional, space or comma separated; empty = latest + short git SHA
DOCKERHUB_TAGS=
# Optional alias of DOCKERHUB_REPOSITORY (used only when DOCKERHUB_REPOSITORY is empty)
DOCKER_IMAGE_NAME=
BUILD_CONTEXT=.
DOCKERFILE_PATH=Dockerfile
